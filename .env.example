# Set false to call your backend instead of the realistic in-browser demo data.
VITE_API_BASE_URL=http://localhost:8000
VITE_USE_MOCK_API=true
# Required only when VITE_USE_MOCK_API=false. These are Supabase public client values.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# Backend development/deployment setting. Include the production origin when
# calling the API from a separate frontend origin.
GOCART_CORS_ORIGINS=http://localhost:5173,https://gocart-kashish-43dd.vercel.app
